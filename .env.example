# Local Qwen is the default. Set LLM_PROVIDER=openai to use OpenAI instead;
# there is no fallback between providers. Put real keys in .env.local (gitignored).
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1
# OPENAI_REASONING_EFFORT=none   (gpt-5 models only)
# Local Qwen through oMLX: http://127.0.0.1:8011/v1, model Qwen3.5-9B-MLX-4bit-938d891.
# Required for real model calls (context budgeting uses the local Qwen tokenizer):
# LOCAL_TOKENIZER_PATH=/path/to/Qwen3.5-9B-MLX-4bit-938d891
# Frozen corpus root (default: data/corpus inside the repository):
# DATA_DIR=/path/to/corpus
# Organisation named in user-facing answers (default: none):
# CORPUS_NAME=
# Embeddings and reranker load pinned Hugging Face revisions from the local cache.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYTORCH_ENABLE_MPS_FALLBACK=0
LANGSMITH_TRACING=false
