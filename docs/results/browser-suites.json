  ],
  "source_note": "Raw evidence is private (Lendo-owned corpus and logs) and is not published. Sources are listed as paths relative to the private capstone folder.",
  "what_it_measures": "Whether scripted Playwright runs through the real chat UI and engineering console pass fixed functional checks: a 16-check demo journey (knowledge answer with citation, LTV card, refinance intent, draft, form handoff, privacy rejection, console, reset) and a 20-question suite across knowledge, LTV, journey, unsupported and privacy categories.",
  "what_it_does_not_show": "Unseen acceptance or general model quality. These are exposed functional examples written during development, with few runs per configuration. Question text, answers and screenshots are not published; checks and questions appear by ID only.",
  "journey_check_ids": {
    "JC01": "chat opens",
    "JC02": "knowledge answer content check",
    "JC03": "knowledge answer has English PDF citation",
    "JC04": "citation PDF opens",
    "JC05": "LTV card shows expected value",
    "JC06": "refinance intent acknowledged without card or draft",
    "JC07": "draft shows expected fields",
    "JC08": "form opens on first step",
    "JC09": "form amounts prefilled",
    "JC10": "form radio selections prefilled",
    "JC11": "form amounts stay editable",
    "JC12": "synthetic email rejected by privacy gate",
    "JC13": "console lists traces",
    "JC14": "console Flow shows LLM and RAG cards",
    "JC15": "console shows privacy detection reason",
    "JC16": "Start over does not recover old amounts"
  },
