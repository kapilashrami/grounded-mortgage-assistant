{
  "study": "Browser suites through the real frontend: 16-check journey and 20-question suite",
  "date": "2026-10-31",
  "source": [
    "evidence/browser/2026-10-31-cleanup-e2e/README.md",
    "evidence/browser/2026-10-31-cleanup-e2e/results-run-*.json",
    "evidence/browser/2026-10-31-openai-provider/README.md",
